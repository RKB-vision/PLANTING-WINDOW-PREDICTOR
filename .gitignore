# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# Local configuration and OS files
.env
.DS_Store

# Runtime databases and generated data
# Recreate the runtime DB with `python -m plantreadiness.seed`; never commit it.
*.db
*.sqlite
*.sqlite3
# generated pipeline output (daily measurement CSV, etc.)
data/generated/
# migration backups (never commit copied DBs)
*.bak-*

# Generated model artifacts
# models/ is committed so collaborators share the reference baseline and
# the synthetic demo models; scratch models/dirs stay ignored.
models_demo/
*.joblib
!models/**

# Private / per-user exports and local artifacts
exports/
private/
*.private.csv

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Front-end UI audit screenshots
ui-audit/

# ESP32-CAM / Cloudinary pipeline artifacts (generated; never commit)
/Plant*.jpg
plant_result*.jpg
plant_captured.jpg
processed_cloudinary_ids.txt
captures/

# Local tooling / MCP session artifacts
.playwright-mcp/
