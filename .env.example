# Copy this file to .env and fill in real values:
#
#   cp .env.example .env
#
# .env is GITIGNORED - never commit real credentials. Real environment
# variables always win over this file, so CI/exported values are respected.
# This template intentionally holds PLACEHOLDERS ONLY - never real secrets.

# --- Cloudinary (server-side ONLY; never put the secret on the ESP32-CAM) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Camera refresh (optional) --------------------------------------------
# Maps a Cloudinary filename prefix to a REGISTERED plant's external_ref.
# Register the plant first:  plant_feedback.py register --ref Plant-01
# Refresh auto-enables when credentials AND at least one source are present.
CAMERA_SOURCES=Plant01_=Plant-01
# Physical reference-rod length in cm. MEASURE IT and set it here; the value
# stays UNVERIFIED until `python -m plantreadiness.verify_calibration` records
# it. If unset, the documented default (30) is used but is NOT assumed correct.
# CAMERA_ROD_LENGTH_CM=30
# CAMERA_REFRESH_ENABLED=1
# CAMERA_MIN_REFRESH_INTERVAL_SECONDS=60

# --- Front-end (optional) --------------------------------------------------
# Where the Next.js proxy finds the Flask API.
PYTHON_BACKEND_URL=http://localhost:8000
