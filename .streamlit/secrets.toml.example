# Copy this file to `.streamlit/secrets.toml` and fill in real values.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# `.streamlit/secrets.toml` is GITIGNORED - it must never be committed.
# On Streamlit Community Cloud, set the same content under
# App settings > Secrets.
#
# NEVER put the Supabase service-role key here (or anywhere in this repo).
# The app uses the anon/public key + signed-in user sessions only, so
# Row Level Security is always enforced.

# Which database backend to use:
#   "supabase" - production / multi-user (Supabase Auth + Postgres RLS)
#   "sqlite"   - local development against the prototype database
backend = "supabase"

[supabase]
# Project URL: Supabase Dashboard > Project Settings > API > Project URL
url = "https://YOUR_PROJECT_REF.supabase.co"

# Anon (public) key - the safe, publishable key. RLS protects the data.
# Again: do NOT use the service-role key.
anon_key = "YOUR_ANON_PUBLIC_KEY"

# Optional: where trained model artefacts live (defaults to ./models)
# models_dir = "./models"

[sqlite]
# Only used when backend = "sqlite"
# path = "./plant_readiness.db"
